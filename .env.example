# Wordshiper Website — Environment Variables
# Copy to `.env` for local `npm run dev`, and set the same keys in
# Cloudflare Pages → Settings → Environment variables for production.

# --- Required for pre-registration / lineage ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Required for lineage welcome emails (subscriber + admin) ---
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM=info@wordshiper.org
ADMIN_NOTIFY_EMAIL=info@wordshiper.org

# --- Donations (pick one path) ---
# A) Hosted Payment Link / Givebutter (simplest — also set as Vite public var)
VITE_DONATION_URL=https://donate.stripe.com/your_payment_link
DONATION_URL=https://donate.stripe.com/your_payment_link
STRIPE_PAYMENT_LINK=https://donate.stripe.com/your_payment_link

# B) Stripe Checkout Sessions (Cloudflare Function /api/donations/checkout)
STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxx
PUBLIC_SITE_URL=https://www.wordshiper.org

# --- Optional ---
# NEON_DATABASE_URL=   # alias for DATABASE_URL
# GOOGLE_CLOUD_TTS_API_KEY=
